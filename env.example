# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AI answers: gemini, openai, or cloudflare (independent of speech provider)
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Workers AI requires an Account ID and API Token with Workers AI access.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_WHISPER_MODEL=@cf/openai/whisper

# Persisted UI preferences
CODING_LANGUAGE=cpp
ACTIVE_SKILL=dsa
# Audio is captured from computer output, never the default microphone.
# Windows: loopback; Linux: parec default output monitor (pulseaudio-utils).
# macOS / Electron 29: exact virtual loopback input name; route output to it.
SYSTEM_AUDIO_DEVICE=

# Speech Recognition Configuration
# Choose one provider: azure, whisper (local), cloudflare, or disabled
SPEECH_PROVIDER=whisper

# Optional: Azure Speech Services Configuration
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# Optional: Local OpenAI Whisper Configuration
# Requires a local Whisper CLI installation, for example:
#   pip install openai-whisper
#   brew install ffmpeg sox
# Use `whisper`, `python3 -m whisper`, or on Windows `.venv-whisper/Scripts/whisper.exe`
WHISPER_COMMAND=whisper
# Optional: where Whisper model weights are stored. Leave unset to use a stable
# app-data folder (recommended). Set an ABSOLUTE path to override; a relative
# path is ignored because it cannot be resolved reliably in packaged builds.
# WHISPER_MODEL_DIR=
WHISPER_MODEL=small
# Shared by local and Cloudflare Whisper. Use ru for Russian with local Whisper
# or Cloudflare whisper-large-v3-turbo; standard Cloudflare whisper auto-detects.
WHISPER_LANGUAGE=auto
WHISPER_SEGMENT_MS=4000
WHISPER_DEVICE=auto
WHISPER_PYTHON=
WHISPER_CAPTURE_MODE=vad
WHISPER_RESPONSE_TARGET=both
WHISPER_MANUAL_MAX_MS=90000
WHISPER_GPU_IDLE_MS=60000
