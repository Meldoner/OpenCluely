# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AI answers: gemini, gemini-live, openai, or cloudflare
# gemini-live uses Gemini-3.8-Live through WebSocket with text output transcription.
# Speech provider is selected independently. To send audio directly to this
# model and receive its transcript and answer in one session, choose
# SPEECH_PROVIDER=gemini-live-audio together with LLM_PROVIDER=gemini-live.
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Workers AI requires an Account ID and API Token with Workers AI access.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_WHISPER_MODEL=@cf/openai/whisper

# Persisted UI preferences
CODING_LANGUAGE=cpp
ACTIVE_SKILL=dsa
# Audio is captured from computer output, never the default microphone.
# Windows: loopback; Linux: parec default output monitor (pulseaudio-utils).
# macOS / Electron 29: exact virtual loopback input name; route output to it.
SYSTEM_AUDIO_DEVICE=

# Speech Recognition Configuration
# Choose one provider: azure, whisper (local), cloudflare, gemini-live,
# gemini-live-audio, or disabled.
# gemini-live uses Gemini-3.5-Transcribe Live and the same GEMINI_API_KEY.
# gemini-live-audio uses Gemini-3.8-Live for audio and answers in one session;
# it requires LLM_PROVIDER=gemini-live. All other speech choices feed text to
# the selected answer model, including Gemini-3.8-Live.
# Language is detected automatically; WHISPER_CAPTURE_MODE selects VAD or manual.
SPEECH_PROVIDER=whisper
# Gemini-3.5-Transcribe Live only: comma-separated BCP-47 language hints.
# Example: ru-RU,en-US. Empty (default) or auto enables automatic detection.
# This does not change Gemini-3.8-Live audio or Whisper recognition settings.
GEMINI_TRANSCRIBE_LANGUAGES=

# Optional: Azure Speech Services Configuration
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# Optional: Local OpenAI Whisper Configuration
# Requires a local Whisper CLI installation, for example:
#   pip install openai-whisper
#   brew install ffmpeg sox
# Use `whisper`, `python3 -m whisper`, or on Windows `.venv-whisper/Scripts/whisper.exe`
WHISPER_COMMAND=whisper
# Optional: where Whisper model weights are stored. Leave unset to use a stable
# app-data folder (recommended). Set an ABSOLUTE path to override; a relative
# path is ignored because it cannot be resolved reliably in packaged builds.
# WHISPER_MODEL_DIR=
WHISPER_MODEL=small
# Shared by local and Cloudflare Whisper. Use ru for Russian with local Whisper
# or Cloudflare whisper-large-v3-turbo; standard Cloudflare whisper auto-detects.
WHISPER_LANGUAGE=auto
WHISPER_SEGMENT_MS=4000
WHISPER_DEVICE=auto
# cuda requires a CUDA-enabled PyTorch wheel in the same environment as
# WHISPER_COMMAND. Explicit cuda never silently falls back to CPU.
WHISPER_PYTHON=
WHISPER_CAPTURE_MODE=vad
WHISPER_RESPONSE_TARGET=both
WHISPER_MANUAL_MAX_MS=90000
WHISPER_GPU_IDLE_MS=60000
