# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AI answers: gemini, gemini-live, openai, or cloudflare
# gemini-live uses Gemini-3.8-Live through WebSocket with text output transcription.
# Speech provider is selected independently. To send audio directly to this
# model and receive its transcript and answer in one session, choose
# SPEECH_PROVIDER=gemini-live-audio together with LLM_PROVIDER=gemini-live.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Workers AI requires an Account ID and API Token with Workers AI access.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_WHISPER_MODEL=@cf/openai/whisper

# Persisted UI preferences
CODING_LANGUAGE=cpp
ACTIVE_SKILL=dsa
# Global dialogue languages for answers and speech (comma-separated BCP-47).
# Example: ru-RU,en-US. Empty follows the question / enables auto-detection.
# Whisper uses auto-detection with multiple languages; Azure uses the first
# selected language (en-US when empty). Standard Cloudflare Whisper detects
# automatically; Turbo accepts a single supported language.
DIALOGUE_LANGUAGES=
# Audio is captured from computer output, never the default microphone.
# Windows: loopback; Linux: parec default output monitor (pulseaudio-utils).
# macOS / Electron 29: exact virtual loopback input name; route output to it.
SYSTEM_AUDIO_DEVICE=

# Speech Recognition Configuration
# Choose one provider: azure, whisper (local), cloudflare, gemini-live,
# gemini-live-audio, or disabled.
# gemini-live uses Gemini-3.5-Transcribe Live and the same GEMINI_API_KEY.
# gemini-live-audio uses Gemini-3.8-Live for audio and answers in one session;
# it requires LLM_PROVIDER=gemini-live. All other speech choices feed text to
# the selected answer model, including Gemini-3.8-Live.
# Language is detected automatically; WHISPER_CAPTURE_MODE selects VAD or manual.
SPEECH_PROVIDER=whisper
# Legacy Transcribe Live hints, used when DIALOGUE_LANGUAGES is absent.
GEMINI_TRANSCRIBE_LANGUAGES=
# Gemini 3.5 Live Transcribe uses a separate built-in vocabulary for each skill.
# Optional overrides: comma-separated canonical terms, at most 100 per skill.
# Leave these commented to use built-ins; an explicit empty value disables that glossary.
# GEMINI_TRANSCRIBE_VOCABULARY_DSA=BFS,DFS,binary search
# GEMINI_TRANSCRIBE_VOCABULARY_DEVOPS=Kubernetes,Terraform,Prometheus
# GEMINI_TRANSCRIBE_VOCABULARY_ANALYST=SQL,ARPU,retention
# GEMINI_TRANSCRIBE_VOCABULARY_BACKEND=PostgreSQL,Redis,Kafka
# GEMINI_TRANSCRIBE_VOCABULARY_ML_ENGINEER=PyTorch,CatBoost,ROC AUC
# GEMINI_TRANSCRIBE_VOCABULARY_AI_ENGINEER=KVCache,RAG,LoRA

# Optional: Azure Speech Services Configuration
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# Optional: Local OpenAI Whisper Configuration
# Requires a local Whisper CLI installation, for example:
#   pip install openai-whisper
#   brew install ffmpeg sox
# Use `whisper`, `python3 -m whisper`, or on Windows `.venv-whisper/Scripts/whisper.exe`
WHISPER_COMMAND=whisper
# Optional: where Whisper model weights are stored. Leave unset to use a stable
# app-data folder (recommended). Set an ABSOLUTE path to override; a relative
# path is ignored because it cannot be resolved reliably in packaged builds.
# WHISPER_MODEL_DIR=
WHISPER_MODEL=small
# Legacy Whisper language, used when DIALOGUE_LANGUAGES is absent.
WHISPER_LANGUAGE=auto
WHISPER_SEGMENT_MS=4000
WHISPER_DEVICE=auto
# cuda requires a CUDA-enabled PyTorch wheel in the same environment as
# WHISPER_COMMAND. Explicit cuda never silently falls back to CPU.
WHISPER_PYTHON=
WHISPER_CAPTURE_MODE=vad
# VAD defaults: 20 ms analysis frames, 80 ms minimum speech, RMS floor 0.0015.
# Forced Whisper chunk boundaries reuse 400 ms; matching transcript prefixes
# are removed only at those boundaries. Temporary HTTP/network failures use
# at most two retries (500/1000 ms backoff) within the segment deadline.
# Gemini Transcribe also reconnects up to twice and replays buffered audio.
# Quiet Whisper segments receive at most 8x gain before transcription.
# Capture stops and drains the queue if 60 seconds of speech accumulate.
# A timeout stops recording, discards pending audio and allows a fresh recording:
# Cloudflare deadline is 120 seconds, local Whisper deadline is 180 seconds.
WHISPER_RESPONSE_TARGET=both
WHISPER_MANUAL_MAX_MS=90000
WHISPER_GPU_IDLE_MS=60000
